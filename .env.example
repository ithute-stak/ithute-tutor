# Ithute Tutor standalone environment
# Tutor owns every value in this file. Do not reuse credentials from another product.

# Tutor PostgreSQL
DB_HOST=tutor-db
DB_PORT=5432
DB_NAME=ithute_tutor
DB_USER=ithute_tutor
DB_PASSWORD=replace-with-a-long-random-tutor-db-password
# DATABASE_URL=postgresql://ithute_tutor:password@tutor-db:5432/ithute_tutor

# Public Tutor URLs
TUTOR_PUBLIC_URL=https://tutor.ithute.co.ls
TUTOR_FRONTEND_URL=https://tutor.ithute.co.ls
NEXT_PUBLIC_TUTOR_API_URL=/api

# Tutor-owned authentication
# Generate a unique random value of at least 32 characters. Never reuse another app's secret.
SECRET_KEY=replace-with-a-long-random-tutor-only-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_COOKIE_NAME=ithute_tutor_access
REFRESH_COOKIE_NAME=ithute_tutor_refresh
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Optional first local super administrator.
# Used only when the email does not already exist in Tutor.
TUTOR_BOOTSTRAP_ADMIN_EMAIL=
TUTOR_BOOTSTRAP_ADMIN_PASSWORD=
TUTOR_BOOTSTRAP_ADMIN_USERNAME=superadmin

# Optional Tutor-specific M-Pesa integration
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_BASE_URL=
MPESA_MARKET=
MPESA_COUNTRY=LS
MPESA_CURRENCY=LSL
MPESA_SHORTCODE=
MPESA_MODEL=
